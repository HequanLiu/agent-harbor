# 监听地址，局域网访问设为 0.0.0.0。
HARBOR_HOST=127.0.0.1

# 后端 API 端口。
HARBOR_API_PORT=8017

# 网页开发服务端口。
HARBOR_WEB_PORT=5177

# 允许跨域访问的前端地址，英文逗号分隔。
HARBOR_ALLOWED_ORIGINS=http://localhost:5177,http://127.0.0.1:5177,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8017,http://127.0.0.1:8017,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# 是否开放用户注册。
HARBOR_ALLOW_REGISTRATION=true

# 是否仅通过 HTTPS 发送 Cookie，本地 HTTP 设为 false。
HARBOR_SECURE_COOKIE=false

# 数据目录，默认使用项目下的 data/。
# HARBOR_DATA_DIR=D:/my-project/agent-harbor/data

# 前端连接的后端地址，修改后需重启开发服务或重新构建。
VITE_HARBOR_SERVER_URL=http://127.0.0.1:8017/

# 连接器令牌加密密钥，使用独立 Fernet 密钥并妥善保存。
HARBOR_CONNECTOR_TOKEN_KEY=

# 允许访问的 MCP/OAuth 来源（协议+域名+端口，不含路径），英文逗号分隔，留空禁用。
HARBOR_CONNECTOR_ALLOWED_ORIGINS=

# OAuth 回调使用的 Harbor API 基础地址。
HARBOR_CONNECTOR_PUBLIC_URL=http://127.0.0.1:8017

# MCP 地址到桥接密钥的 JSON 映射，MES 密钥须与 MES_MCP_HARBOR_BRIDGE_KEY 一致。
HARBOR_CONNECTOR_BRIDGE_KEYS={}

# Docker 沙箱镜像，使用前运行 scripts/build_sandbox.py 构建。
HARBOR_SANDBOX_IMAGE=harbor-sandbox:dev

# 当前后端进程允许的活跃沙箱数上限。
HARBOR_SANDBOX_MAX_ACTIVE=8

# 每个用户允许的活跃沙箱数上限。
HARBOR_SANDBOX_MAX_PER_OWNER=4

# 工作区模式，默认 docker 隔离运行。
# trusted_single_user_local disables Docker and also supports connectors.
HARBOR_WORKSPACE_MODE=docker

# 沙箱快照数量上限。
HARBOR_SANDBOX_MAX_SNAPSHOTS=16

# 每个用户的沙箱快照数量上限。
HARBOR_SANDBOX_MAX_SNAPSHOTS_PER_OWNER=4
