# API and browser are local-only by default.
HARBOR_HOST=127.0.0.1
HARBOR_API_PORT=8017
HARBOR_WEB_PORT=5177
HARBOR_ALLOWED_ORIGINS=http://localhost:5177,http://127.0.0.1:5177,http://localhost:8017,http://127.0.0.1:8017,tauri://localhost,http://tauri.localhost,https://tauri.localhost
HARBOR_ALLOW_REGISTRATION=true
# Set true behind HTTPS; leave false for local HTTP development.
HARBOR_SECURE_COOKIE=false
# Optional: absolute directory, defaults to this project's data/.
# HARBOR_DATA_DIR=D:/my-project/agent-harbor/data
# Configure model credentials in the web UI after registration.
