{
  "identifier": "desktop",
  "description": "Main window: authenticated server API and user-selected document saving",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://localhost:*"
        }
      ]
    },
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}
